      <description>&lt;div class=&#34;about-page&#34;&gt;&#xD;&#xA;  &lt;div class=&#34;about-decor&#34;&gt;&#xD;&#xA;    &lt;span class=&#34;decor-paw&#34; style=&#34;top:4%;left:8%;animation-delay:0s&#34;&gt;🐾&lt;/span&gt;&#xD;&#xA;    &lt;span class=&#34;decor-paw&#34; style=&#34;top:16%;right:6%;animation-delay:1.3s&#34;&gt;🐾&lt;/span&gt;&#xD;&#xA;    &lt;span class=&#34;decor-paw&#34; style=&#34;top:30%;left:3%;animation-delay:2.6s&#34;&gt;🐾&lt;/span&gt;&#xD;&#xA;    &lt;span class=&#34;decor-paw&#34; style=&#34;top:55%;right:5%;animation-delay:0.7s&#34;&gt;🐾&lt;/span&gt;&#xD;&#xA;    &lt;span class=&#34;decor-paw&#34; style=&#34;top:72%;left:6%;animation-delay:2.0s&#34;&gt;🐾&lt;/span&gt;&#xD;&#xA;    &lt;span class=&#34;decor-paw&#34; style=&#34;top:88%;right:8%;animation-delay:3.2s&#34;&gt;🐾&lt;/span&gt;&#xD;&#xA;    &lt;span class=&#34;decor-sparkle&#34; style=&#34;top:12%;left:20%;animation-delay:0.3s&#34;&gt;✦&lt;/span&gt;&#xD;&#xA;    &lt;span class=&#34;decor-sparkle&#34; style=&#34;top:38%;right:16%;animation-delay:1.6s&#34;&gt;✧&lt;/span&gt;&#xD;&#xA;    &lt;span class=&#34;decor-sparkle&#34; style=&#34;top:65%;left:18%;animation-delay:2.3s&#34;&gt;⋆&lt;/span&gt;&#xD;&#xA;    &lt;span class=&#34;decor-sparkle&#34; style=&#34;top:82%;right:20%;animation-delay:3.0s&#34;&gt;✦&lt;/span&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;  &lt;!-- ====== Hero ====== --&gt;&#xD;&#xA;  &lt;section class=&#34;about-hero&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;about-avatar-frame&#34;&gt;&#xD;&#xA;      &lt;div class=&#34;about-cat-ear about-cat-ear-left&#34;&gt;&lt;/div&gt;&#xD;&#xA;      &lt;div class=&#34;about-cat-ear about-cat-ear-right&#34;&gt;&lt;/div&gt;&#xD;&#xA;      &lt;div class=&#34;about-avatar-ring&#34;&gt;&lt;/div&gt;&#xD;&#xA;      &lt;div class=&#34;about-avatar-inner&#34;&gt;&#xD;&#xA;        &lt;img src=&#34;https://avatars.githubusercontent.com/u/193340716?v=4&#34; alt=&#34;成霜·喵喵的头像&#34;&gt;&#xD;&#xA;      &lt;/div&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;    &lt;h1 class=&#34;about-name&#34;&gt;成霜·喵喵&lt;/h1&gt;&#xD;&#xA;    &lt;p class=&#34;about-subtitle&#34;&gt;逐光前行的生活记录者&lt;/p&gt;&#xD;&#xA;  &lt;/section&gt;&#xD;&#xA;  &lt;!-- ====== 状态卡片 ====== --&gt;&#xD;&#xA;  &lt;section class=&#34;about-status&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;status-grid&#34;&gt;&#xD;&#xA;      &lt;div class=&#34;status-item&#34;&gt;&#xD;&#xA;        &lt;span class=&#34;status-emoji&#34;&gt;🎓&lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;status-label&#34;&gt;身份&lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;status-value&#34;&gt;大一新生&lt;/span&gt;&#xD;&#xA;      &lt;/div&gt;&#xD;&#xA;      &lt;div class=&#34;status-item&#34;&gt;&#xD;&#xA;        &lt;span class=&#34;status-emoji&#34;&gt;🐱&lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;status-label&#34;&gt;属性&lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;status-value&#34;&gt;猫娘型&lt;/span&gt;&#xD;&#xA;      &lt;/div&gt;&#xD;&#xA;      &lt;div class=&#34;status-item&#34;&gt;&#xD;&#xA;        &lt;span class=&#34;status-emoji&#34;&gt;💻&lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;status-label&#34;&gt;技能&lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;status-value&#34;&gt;技术探索&lt;/span&gt;&#xD;&#xA;      &lt;/div&gt;&#xD;&#xA;      &lt;div class=&#34;status-item&#34;&gt;&#xD;&#xA;        &lt;span class=&#34;status-emoji&#34;&gt;📅&lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;status-label&#34;&gt;博客&lt;/span&gt;&#xD;&#xA;        &lt;span class=&#34;status-value&#34;&gt;2025.06&lt;/span&gt;&#xD;&#xA;      &lt;/div&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;  &lt;/section&gt;&#xD;&#xA;  &lt;!-- ====== 自我介绍 ====== --&gt;&#xD;&#xA;  &lt;section class=&#34;about-intro&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;about-section-label&#34;&gt;&#xD;&#xA;      &lt;span class=&#34;section-line&#34;&gt;&lt;/span&gt;&#xD;&#xA;      &lt;span class=&#34;section-text&#34;&gt;🐾 关 于 我 🐾&lt;/span&gt;&#xD;&#xA;      &lt;span class=&#34;section-line&#34;&gt;&lt;/span&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;    &lt;div class=&#34;about-intro-card&#34;&gt;&#xD;&#xA;      &lt;p&gt;窝是&lt;strong&gt;成霜·喵喵&lt;/strong&gt;，一名刚开启大一生活的新生。&lt;/p&gt;&#xD;&#xA;      &lt;p&gt;昔日为高考埋头赶路，如今终于走到了曾经向往的&lt;strong&gt;诗与远方&lt;/strong&gt;。新的生活正缓缓铺开，校园烟火与日常细碎皆成风景，顺着热爱慢慢往前走就好。&lt;/p&gt;&#xD;&#xA;      &lt;p class=&#34;about-intro-date&#34;&gt;本站于 &lt;strong&gt;2025年6月19日&lt;/strong&gt; 正式上线，从高考征途到大学新篇，始终记录生活点滴与所思所感。&lt;/p&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;  &lt;/section&gt;&#xD;&#xA;  &lt;!-- ====== 座右铭 ====== --&gt;&#xD;&#xA;  &lt;section class=&#34;about-motto&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;about-motto-card&#34;&gt;&#xD;&#xA;      &lt;div class=&#34;motto-quote-mark&#34;&gt;&#34;&lt;/div&gt;&#xD;&#xA;      &lt;p class=&#34;about-motto-text&#34;&gt;苟且是暂时的，远方是迟早的。&lt;br&gt;攒够六便士，就去追月亮。&lt;/p&gt;&#xD;&#xA;      &lt;p class=&#34;about-motto-author&#34;&gt;—— 成霜·喵喵&lt;/p&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;  &lt;/section&gt;&#xD;&#xA;  &lt;!-- ====== 标签 ====== --&gt;&#xD;&#xA;  &lt;section class=&#34;about-tags&#34;&gt;&#xD;&#xA;    &lt;span class=&#34;about-pill&#34;&gt;🐱 学习型猫猫&lt;/span&gt;&#xD;&#xA;    &lt;span class=&#34;about-pill&#34;&gt;💻 技术爱好者&lt;/span&gt;&#xD;&#xA;    &lt;span class=&#34;about-pill&#34;&gt;🎀 软萌爱好者&lt;/span&gt;&#xD;&#xA;    &lt;span class=&#34;about-pill&#34;&gt;👂 猫耳收藏家&lt;/span&gt;&#xD;&#xA;    &lt;span class=&#34;about-pill&#34;&gt;📋 2305班信息委员&lt;/span&gt;&#xD;&#xA;    &lt;span class=&#34;about-pill&#34;&gt;🌙 生活记录者&lt;/span&gt;&#xD;&#xA;  &lt;/section&gt;&#xD;&#xA;  &lt;!-- ====== 联系方式 ====== --&gt;&#xD;&#xA;  &lt;section class=&#34;about-links&#34;&gt;&#xD;&#xA;    &lt;a class=&#34;about-link-card&#34; href=&#34;https://github.com/YLCS-MM&#34; target=&#34;_blank&#34; rel=&#34;noopener&#34;&gt;&#xD;&#xA;      &lt;span class=&#34;about-link-icon&#34;&gt;🐈&lt;/span&gt;&#xD;&#xA;      &lt;span class=&#34;about-link-label&#34;&gt;GitHub&lt;/span&gt;&#xD;&#xA;      &lt;span class=&#34;about-link-value&#34;&gt;@YLCS-MM&lt;/span&gt;&#xD;&#xA;    &lt;/a&gt;&#xD;&#xA;    &lt;a class=&#34;about-link-card&#34; href=&#34;mailto:2992412549@qq.com&#34;&gt;&#xD;&#xA;      &lt;span class=&#34;about-link-icon&#34;&gt;✉️&lt;/span&gt;&#xD;&#xA;      &lt;span class=&#34;about-link-label&#34;&gt;邮箱&lt;/span&gt;&#xD;&#xA;      &lt;span class=&#34;about-link-value&#34;&gt;2992412549@qq.com&lt;/span&gt;&#xD;&#xA;    &lt;/a&gt;&#xD;&#xA;  &lt;/section&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;style&gt;&#xD;&#xA;/* ===== About Page — nachoneko 猫娘配色 ===== */&#xD;&#xA;.about-page {&#xD;&#xA;  --nn-blue:        #7eb8da;&#xD;&#xA;  --nn-blue-soft:   #a8d5f0;&#xD;&#xA;  --nn-lavender:    #b4a5d6;&#xD;&#xA;  --nn-lav-light:   #d5cee8;&#xD;&#xA;  --nn-card:         rgba(255,255,255,0.78);&#xD;&#xA;  --nn-border:       rgba(126,184,218,0.28);&#xD;&#xA;  --nn-glow:         rgba(126,184,218,0.18);&#xD;&#xA;  --nn-shadow:       0 2px 14px rgba(126,184,218,0.08);&#xD;&#xA;  --nn-shadow-lg:    0 8px 28px rgba(126,184,218,0.12);&#xD;&#xA;&#xD;&#xA;  width: 100%;&#xD;&#xA;  padding: 32px 40px 56px;&#xD;&#xA;  text-align: center;&#xD;&#xA;  position: relative;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;/* ----- 装饰猫爪 + 星光 ----- */&#xD;&#xA;.about-decor {&#xD;&#xA;  position: absolute;&#xD;&#xA;  inset: -10px -30px -30px;&#xD;&#xA;  pointer-events: none;&#xD;&#xA;  z-index: 0;&#xD;&#xA;  overflow: hidden;&#xD;&#xA;}&#xD;&#xA;.decor-paw {&#xD;&#xA;  position: absolute;&#xD;&#xA;  font-size: 1.3em;&#xD;&#xA;  opacity: 0;&#xD;&#xA;  animation: pawFloat 5s infinite ease-in-out;&#xD;&#xA;}&#xD;&#xA;@keyframes pawFloat {&#xD;&#xA;  0%, 100% { opacity: 0; transform: translateY(0) rotate(0deg); }&#xD;&#xA;  22% { opacity: 0.3; }&#xD;&#xA;  50% { opacity: 0.1; transform: translateY(-14px) rotate(10deg); }&#xD;&#xA;}&#xD;&#xA;.decor-sparkle {&#xD;&#xA;  position: absolute;&#xD;&#xA;  color: var(--nn-lav-light);&#xD;&#xA;  font-size: 0.95em;&#xD;&#xA;  opacity: 0;&#xD;&#xA;  animation: sparkleTwinkle 3.5s infinite ease-in-out;&#xD;&#xA;}&#xD;&#xA;@keyframes sparkleTwinkle {&#xD;&#xA;  0%, 100% { opacity: 0; transform: scale(0.7); }&#xD;&#xA;  40% { opacity: 0.5; transform: scale(1.15); }&#xD;&#xA;  70% { opacity: 0.15; }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;/* ====== Hero ====== */&#xD;&#xA;.about-hero {&#xD;&#xA;  margin-bottom: 28px;&#xD;&#xA;  position: relative;&#xD;&#xA;  z-index: 1;&#xD;&#xA;}&#xD;&#xA;.about-avatar-frame {&#xD;&#xA;  position: relative;&#xD;&#xA;  width: 150px;&#xD;&#xA;  height: 150px;&#xD;&#xA;  margin: 0 auto 22px;&#xD;&#xA;}&#xD;&#xA;/* 猫耳 */&#xD;&#xA;.about-cat-ear {&#xD;&#xA;  position: absolute;&#xD;&#xA;  width: 0; height: 0;&#xD;&#xA;  border-left: 10px solid transparent;&#xD;&#xA;  border-right: 10px solid transparent;&#xD;&#xA;  border-bottom: 18px solid var(--nn-blue-soft);&#xD;&#xA;  z-index: 0;&#xD;&#xA;  opacity: 0.65;&#xD;&#xA;}&#xD;&#xA;.about-cat-ear-left  { top: -8px;  left: 28px;  transform: rotate(-22deg); }&#xD;&#xA;.about-cat-ear-right { top: -8px;  right: 28px; transform: rotate(22deg); }&#xD;&#xA;&#xD;&#xA;.about-avatar-ring {&#xD;&#xA;  position: absolute;&#xD;&#xA;  inset: -8px;&#xD;&#xA;  border-radius: 50%;&#xD;&#xA;  border: 2px dashed rgba(126,184,218,0.4);&#xD;&#xA;  animation: ringSpin 22s linear infinite;&#xD;&#xA;}&#xD;&#xA;@keyframes ringSpin { to { transform: rotate(360deg); } }&#xD;&#xA;&#xD;&#xA;.about-avatar-inner {&#xD;&#xA;  width: 130px; height: 130px;&#xD;&#xA;  border-radius: 50%;&#xD;&#xA;  border: 3px solid #fff;&#xD;&#xA;  box-shadow: 0 0 0 2px var(--nn-blue-soft), 0 4px 22px var(--nn-glow);&#xD;&#xA;  overflow: hidden;&#xD;&#xA;  position: absolute;&#xD;&#xA;  top: 50%; left: 50%;&#xD;&#xA;  transform: translate(-50%, -50%);&#xD;&#xA;  animation: aboutFloat 3s ease-in-out infinite;&#xD;&#xA;  z-index: 1;&#xD;&#xA;}&#xD;&#xA;@keyframes aboutFloat {&#xD;&#xA;  0%, 100% { transform: translate(-50%, -50%) translateY(0); }&#xD;&#xA;  50% { transform: translate(-50%, -50%) translateY(-5px); }&#xD;&#xA;}&#xD;&#xA;.about-avatar-inner img { width: 100%; height: 100%; object-fit: cover; }&#xD;&#xA;&#xD;&#xA;.about-name {&#xD;&#xA;  font-size: 1.7em;&#xD;&#xA;  color: var(--nn-lavender);&#xD;&#xA;  font-weight: 700;&#xD;&#xA;  letter-spacing: 4px;&#xD;&#xA;  margin-bottom: 6px;&#xD;&#xA;}&#xD;&#xA;.about-subtitle {&#xD;&#xA;  font-size: 0.9em;&#xD;&#xA;  color: #8899b0;&#xD;&#xA;  margin: 0;&#xD;&#xA;  letter-spacing: 2px;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;/* ====== 状态卡片 ====== */&#xD;&#xA;.about-status {&#xD;&#xA;  margin-bottom: 28px;&#xD;&#xA;  position: relative;&#xD;&#xA;  z-index: 1;&#xD;&#xA;}&#xD;&#xA;.status-grid {&#xD;&#xA;  display: grid;&#xD;&#xA;  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));&#xD;&#xA;  gap: 12px;&#xD;&#xA;}&#xD;&#xA;.status-item {&#xD;&#xA;  background: var(--nn-card);&#xD;&#xA;  backdrop-filter: blur(8px);&#xD;&#xA;  -webkit-backdrop-filter: blur(8px);&#xD;&#xA;  border: 1px solid var(--nn-border);&#xD;&#xA;  border-radius: 14px;&#xD;&#xA;  padding: 16px 8px;&#xD;&#xA;  display: flex;&#xD;&#xA;  flex-direction: column;&#xD;&#xA;  align-items: center;&#xD;&#xA;  gap: 4px;&#xD;&#xA;  box-shadow: var(--nn-shadow);&#xD;&#xA;  transition: all 0.3s ease;&#xD;&#xA;}&#xD;&#xA;.status-item:hover {&#xD;&#xA;  transform: translateY(-3px);&#xD;&#xA;  box-shadow: 0 6px 20px var(--nn-glow);&#xD;&#xA;}&#xD;&#xA;.status-emoji {&#xD;&#xA;  font-size: 1.4em;&#xD;&#xA;}&#xD;&#xA;.status-label {&#xD;&#xA;  font-size: 0.7em;&#xD;&#xA;  color: #8899b0;&#xD;&#xA;  text-transform: uppercase;&#xD;&#xA;  letter-spacing: 1px;&#xD;&#xA;}&#xD;&#xA;.status-value {&#xD;&#xA;  font-size: 0.85em;&#xD;&#xA;  color: var(--nn-blue);&#xD;&#xA;  font-weight: 600;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;/* ====== 分区标签 ====== */&#xD;&#xA;.about-section-label {&#xD;&#xA;  display: flex;&#xD;&#xA;  align-items: center;&#xD;&#xA;  justify-content: center;&#xD;&#xA;  gap: 14px;&#xD;&#xA;  margin-bottom: 16px;&#xD;&#xA;  position: relative;&#xD;&#xA;  z-index: 1;&#xD;&#xA;}&#xD;&#xA;.section-line {&#xD;&#xA;  flex: 1;&#xD;&#xA;  max-width: 100px;&#xD;&#xA;  height: 1px;&#xD;&#xA;  background: linear-gradient(90deg, transparent, var(--nn-blue-soft), transparent);&#xD;&#xA;}&#xD;&#xA;.section-text {&#xD;&#xA;  font-size: 0.78em;&#xD;&#xA;  color: #8899b0;&#xD;&#xA;  letter-spacing: 3px;&#xD;&#xA;  font-weight: 500;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;/* ====== 自我介绍 ====== */&#xD;&#xA;.about-intro {&#xD;&#xA;  margin-bottom: 24px;&#xD;&#xA;  position: relative;&#xD;&#xA;  z-index: 1;&#xD;&#xA;}&#xD;&#xA;.about-intro-card {&#xD;&#xA;  background: var(--nn-card);&#xD;&#xA;  backdrop-filter: blur(10px);&#xD;&#xA;  -webkit-backdrop-filter: blur(10px);&#xD;&#xA;  border: 1px solid var(--nn-border);&#xD;&#xA;  border-radius: 18px;&#xD;&#xA;  padding: 32px 36px;&#xD;&#xA;  line-height: 1.9;&#xD;&#xA;  font-size: 0.95em;&#xD;&#xA;  box-shadow: var(--nn-shadow);&#xD;&#xA;  transition: box-shadow 0.3s ease;&#xD;&#xA;  text-align: left;&#xD;&#xA;}&#xD;&#xA;.about-intro-card:hover {&#xD;&#xA;  box-shadow: var(--nn-shadow-lg);&#xD;&#xA;}&#xD;&#xA;.about-intro-card p {&#xD;&#xA;  margin-bottom: 8px;&#xD;&#xA;  text-indent: 2em;&#xD;&#xA;}&#xD;&#xA;.about-intro-card p:last-child {&#xD;&#xA;  margin-bottom: 0;&#xD;&#xA;}&#xD;&#xA;.about-intro-card strong {&#xD;&#xA;  color: var(--nn-blue);&#xD;&#xA;  font-weight: 600;&#xD;&#xA;}&#xD;&#xA;.about-intro-date {&#xD;&#xA;  font-size: 0.85em;&#xD;&#xA;  color: #8899b0;&#xD;&#xA;  margin-top: 6px !important;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;/* ====== 座右铭 ====== */&#xD;&#xA;.about-motto {&#xD;&#xA;  margin-bottom: 24px;&#xD;&#xA;  position: relative;&#xD;&#xA;  z-index: 1;&#xD;&#xA;}&#xD;&#xA;.about-motto-card {&#xD;&#xA;  position: relative;&#xD;&#xA;  background: linear-gradient(135deg, rgba(232,242,250,0.75), rgba(213,206,232,0.55));&#xD;&#xA;  border-left: 3px solid var(--nn-blue-soft);&#xD;&#xA;  border-radius: 0 18px 18px 0;&#xD;&#xA;  padding: 22px 26px 22px 40px;&#xD;&#xA;  text-align: left;&#xD;&#xA;}&#xD;&#xA;.motto-quote-mark {&#xD;&#xA;  position: absolute;&#xD;&#xA;  top: 6px;&#xD;&#xA;  left: 14px;&#xD;&#xA;  font-size: 2.2em;&#xD;&#xA;  color: var(--nn-lav-light);&#xD;&#xA;  opacity: 0.45;&#xD;&#xA;  font-family: Georgia, serif;&#xD;&#xA;  line-height: 1;&#xD;&#xA;}&#xD;&#xA;.about-motto-text {&#xD;&#xA;  font-size: 0.95em;&#xD;&#xA;  font-style: italic;&#xD;&#xA;  color: #5a6a7e;&#xD;&#xA;  margin-bottom: 10px;&#xD;&#xA;  line-height: 1.8;&#xD;&#xA;}&#xD;&#xA;.about-motto-author {&#xD;&#xA;  font-size: 0.82em;&#xD;&#xA;  color: #8899b0;&#xD;&#xA;  margin: 0;&#xD;&#xA;  text-align: right;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;/* ====== 标签 Pills ====== */&#xD;&#xA;.about-tags {&#xD;&#xA;  display: flex;&#xD;&#xA;  flex-wrap: wrap;&#xD;&#xA;  gap: 10px;&#xD;&#xA;  justify-content: center;&#xD;&#xA;  margin-bottom: 28px;&#xD;&#xA;  position: relative;&#xD;&#xA;  z-index: 1;&#xD;&#xA;}&#xD;&#xA;.about-pill {&#xD;&#xA;  display: inline-block;&#xD;&#xA;  padding: 7px 18px;&#xD;&#xA;  border-radius: 20px;&#xD;&#xA;  font-size: 0.84em;&#xD;&#xA;  color: var(--nn-blue);&#xD;&#xA;  background: rgba(232,242,250,0.55);&#xD;&#xA;  border: 1px solid var(--nn-border);&#xD;&#xA;  transition: all 0.3s ease;&#xD;&#xA;  cursor: default;&#xD;&#xA;}&#xD;&#xA;.about-pill:hover {&#xD;&#xA;  background: var(--nn-lavender);&#xD;&#xA;  border-color: var(--nn-lavender);&#xD;&#xA;  color: #fff;&#xD;&#xA;  transform: translateY(-2px);&#xD;&#xA;  box-shadow: 0 4px 16px rgba(180,165,214,0.3);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;/* ====== 联系方式 ====== */&#xD;&#xA;.about-links {&#xD;&#xA;  display: flex;&#xD;&#xA;  flex-wrap: wrap;&#xD;&#xA;  gap: 14px;&#xD;&#xA;  justify-content: center;&#xD;&#xA;  position: relative;&#xD;&#xA;  z-index: 1;&#xD;&#xA;}&#xD;&#xA;.about-link-card {&#xD;&#xA;  display: flex;&#xD;&#xA;  flex-direction: column;&#xD;&#xA;  align-items: center;&#xD;&#xA;  gap: 6px;&#xD;&#xA;  padding: 22px 32px;&#xD;&#xA;  min-width: 160px;&#xD;&#xA;  background: var(--nn-card);&#xD;&#xA;  backdrop-filter: blur(8px);&#xD;&#xA;  -webkit-backdrop-filter: blur(8px);&#xD;&#xA;  border: 1px solid var(--nn-border);&#xD;&#xA;  border-radius: 18px;&#xD;&#xA;  text-decoration: none;&#xD;&#xA;  box-shadow: var(--nn-shadow);&#xD;&#xA;  transition: all 0.3s ease;&#xD;&#xA;}&#xD;&#xA;.about-link-card:hover {&#xD;&#xA;  transform: translateY(-4px);&#xD;&#xA;  box-shadow: 0 8px 28px var(--nn-glow);&#xD;&#xA;  border-color: var(--nn-blue-soft);&#xD;&#xA;}&#xD;&#xA;.about-link-icon  { font-size: 1.5em; }&#xD;&#xA;.about-link-label { font-size: 0.88em; font-weight: 600; color: var(--nn-lavender); }&#xD;&#xA;.about-link-value { font-size: 0.8em; color: #8899b0; word-break: break-all; }&#xD;&#xA;&#xD;&#xA;/* ====== Responsive ====== */&#xD;&#xA;@media (max-width: 1024px) {&#xD;&#xA;  .about-page { padding: 24px 28px 44px; }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;@media (max-width: 768px) {&#xD;&#xA;  .about-page { padding: 20px 20px 40px; }&#xD;&#xA;  .about-decor { inset: -6px -18px -18px; }&#xD;&#xA;  .decor-paw { font-size: 1.05em; }&#xD;&#xA;  .about-avatar-frame { width: 130px; height: 130px; }&#xD;&#xA;  .about-avatar-inner { width: 112px; height: 112px; }&#xD;&#xA;  .about-cat-ear {&#xD;&#xA;    border-left-width: 9px;&#xD;&#xA;    border-right-width: 9px;&#xD;&#xA;    border-bottom-width: 16px;&#xD;&#xA;  }&#xD;&#xA;  .about-cat-ear-left { left: 20px; top: -7px; }&#xD;&#xA;  .about-cat-ear-right { right: 20px; top: -7px; }&#xD;&#xA;  .about-name { font-size: 1.5em; }&#xD;&#xA;  .status-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }&#xD;&#xA;  .about-intro-card { padding: 24px 28px; font-size: 0.93em; }&#xD;&#xA;  .about-motto-card { padding: 18px 20px 18px 34px; }&#xD;&#xA;  .about-pill { padding: 5px 14px; font-size: 0.77em; }&#xD;&#xA;  .about-link-card { min-width: 140px; padding: 18px 28px; }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;@media (max-width: 480px) {&#xD;&#xA;  .about-page { padding: 12px 12px 28px; }&#xD;&#xA;  .about-avatar-frame { width: 96px; height: 96px; }&#xD;&#xA;  .about-avatar-inner { width: 82px; height: 82px; }&#xD;&#xA;  .about-avatar-ring { display: none; }&#xD;&#xA;  .about-cat-ear { display: none; }&#xD;&#xA;  .about-decor { display: none; }&#xD;&#xA;  .about-name { font-size: 1.2em; letter-spacing: 2px; }&#xD;&#xA;  .status-grid { gap: 8px; }&#xD;&#xA;  .status-item { padding: 12px 6px; }&#xD;&#xA;  .about-intro-card { padding: 16px 16px; font-size: 0.87em; }&#xD;&#xA;  .about-intro-card p { text-indent: 1.5em; }&#xD;&#xA;  .about-link-card { min-width: 0; flex: 1 1 100%; padding: 14px 20px; }&#xD;&#xA;  .section-line { max-width: 40px; }&#xD;&#xA;}&#xD;&#xA;&lt;/style&gt;</description>
